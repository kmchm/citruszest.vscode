      "foreground": "#585800",
      "fontStyle": "italic"
    },
    "function": "#00663D",
    "method": "#00663D",
    "decorator": "#00663D",
    "macro": "#005C7C",
    "parameter": {
      "foreground": "#005C7C",
      "fontStyle": "italic"
    },
    "property": "#005F60",
    "variable": "#1A1A1A",
    "variable.readonly": "#993200",
    "variable.defaultLibrary": "#585800",
    "event": "#3A3A3A",
    "modifier": "#3A3A3A",
    "regexp": "#864300",
    "operator": "#585800",
    "keyword": "#005C7C",
    "string": "#086300",
    "number": "#655400",
    "comment": "#00631D",
    "*.defaultLibrary": "#005C7C",
    "function.defaultLibrary": "#00663D",
    "selfKeyword": {
      "foreground": "#585800",
      "fontStyle": "italic"
    },
    "builtinConstant": "#AF0000",
    "deprecated": {
      "strikethrough": true
    },
    "unresolvedReference": {
      "foreground": "#AF0000",
      "underline": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#00631D"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#005D8F"
      }
    },
    {
      "name": "Comment tag (TODO/FIXME)",
      "scope": [
        "keyword.codetag",
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#864300"
      }
    },
    {
      "name": "JSDoc / docstring variable",
      "scope": [
        "variable.other.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#655400"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#086300"
      }
    },
    {
      "name": "Character literal",
      "scope": [
        "constant.character",
        "string.quoted.single.character"
      ],
      "settings": {
        "foreground": "#645400"
      }
    },
    {
      "name": "Escape sequence",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#AB0044"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string",
