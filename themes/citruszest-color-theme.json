    "number": "#FFF2B3",
    "comment": "#659B75",
    "*.defaultLibrary": "#00BFFF",
    "function.defaultLibrary": "#1AFFA3",
    "selfKeyword": {
      "foreground": "#FFFF00",
      "fontStyle": "italic"
    },
    "builtinConstant": "#FF5454",
    "deprecated": {
      "strikethrough": true
    },
    "unresolvedReference": {
      "foreground": "#FF5454",
      "underline": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#659B75"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#9ADCFF"
      }
    },
    {
      "name": "Comment tag (TODO/FIXME)",
      "scope": [
        "keyword.codetag",
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#FFAA54"
      }
    },
    {
      "name": "JSDoc / docstring variable",
      "scope": [
        "variable.other.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#FFF2B3"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#B2F3AC"
      }
    },
    {
      "name": "Character literal",
      "scope": [
        "constant.character",
        "string.quoted.single.character"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Escape sequence",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FF1A75"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string",
